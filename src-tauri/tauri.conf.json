{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trawangan",
  "version": "0.17.0",
  "identifier": "com.trawangan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "trawangan · Crypto Charting Terminal",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["trawangan"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Native Crypto Charting Desktop App",
    "longDescription": "Ultra-lightweight crypto charting application powered by LuxAlgo Vela and PineTS",
    "publisher": "Trawangan",
    "copyright": "Copyright 2026 Trawangan",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": false
      }
    }
  }
}
